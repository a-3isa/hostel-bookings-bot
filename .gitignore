# Secrets. Named explicitly rather than with a blanket *.json — that rule kept
# the service account out of the repo but also silently swallowed every config,
# fixture and workflow export alongside it.
.env
.env.*
!.env.example
*.pem
*.key
service_account.json
*credentials*.json
*service_account*.json

__pycache__/
.pytest_cache/
*.pyc
.superpowers/
.playwright-mcp/
bot_out.txt
bot_err.txt
*.log

# The rebuilt workflow's id, which is per-instance and not a repo fact.
booking_bot/.workflow_id

# Snapshots from supabase/backup.py. Never committable: workflow.json carries
# BOT_TOKEN in its Config node, and the sheet and database carry guests' names
# and phone numbers.
backups/
